# PostgreSQL (docker compose provides this by default)
DATABASE_URL=postgres://hostayo:hostayo@localhost:5432/hostayo

# Redis (the local Docker service exposed on host port 6380)
REDIS_URL=redis://localhost:6380
# Production: configure REDIS_URL in Vercel with the managed TLS URL.
# Never commit the production credential to this file.

# Neon Object Storage (S3-compatible). Keep credentials only in .env/.env.local.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=hostayo-uploads

# Better Auth. In Vercel, set this to the canonical production URL (for
# example https://hostayo.vercel.app or your custom domain). Preview URLs are
# allowed dynamically by the auth configuration.
BETTER_AUTH_URL=http://localhost:3000
# Production: https://app.hostayo.casa. demo.hostayo.casa serves the same deployment
# (allowed in src/lib/auth/index.ts); a Cloudflare redirect sends / to /login?demo=1.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-random-secret

# Vercel Cron uses this to authorize the nightly demo reset endpoint.
# Generate a value with: openssl rand -base64 32
CRON_SECRET=change-me-generate-a-random-secret

# Set to false for advertising mode: removes the Sign in buttons from public pages (terms, privacy).
APP_IS_LIVE=true

# The marketing site. The logo on the legal pages leads here instead of into the app.
NEXT_PUBLIC_SITE_URL=https://hostayo.casa

# Required. Where people reach the team (Settings → Support and the legal pages).
NEXT_PUBLIC_SUPPORT_EMAIL=support@hostayo.casa

# Google Analytics measurement ID for the app. Only loaded after a visitor chooses Accept all.
NEXT_PUBLIC_GA_ID=G-YK82FP7WL1
